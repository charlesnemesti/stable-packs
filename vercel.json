{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo static-site",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/agent",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/agent/",
      "destination": "/",
      "permanent": false
    }
  ]
}
